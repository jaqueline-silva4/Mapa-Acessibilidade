# ==========================================
# Produção (Nginx + HTTPS Let's Encrypt)
# Copie este arquivo para ".env" na raiz do projeto:
#   cp .env.prod.example .env
# E suba com:
#   docker compose -f docker-compose.prod.yml up -d --build
# ==========================================

# Domínio público apontando para o IP deste servidor (portas 80 e 443 abertas)
DOMAIN=acessamais.seudominio.com.br

# E-mail para emissão/avisos do certificado Let's Encrypt
LETSENCRYPT_EMAIL=contato@seudominio.com.br

# Use 1 para testar sem consumir limite do Let's Encrypt, 0 para certificado válido em produção
LETSENCRYPT_STAGING=0

# Banco de Dados MySQL
DB_NAME=mapa_acessibilidade
DB_ROOT_PASSWORD=troque-por-uma-senha-forte-do-mysql

# Segurança JWT
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria
JWT_EXPIRES_IN=1h

# E-mail (opcional - recuperação de senha)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Acessa+ <nao-responder@seudominio.com.br>"
