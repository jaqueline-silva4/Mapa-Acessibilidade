# ==========================================
# Configurações do Servidor / Aplicação
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Configurações do Banco de Dados (MySQL)
# ==========================================
DB_HOST=localhost
DB_PORT=3305
DB_NAME=mapa_acessibilidade
DB_USER=root
DB_PASSWORD=rootpassword
DB_ROOT_PASSWORD=rootpassword

# ==========================================
# URL de Conexão do Prisma ORM
# ==========================================
DATABASE_URL="mysql://root:rootpassword@localhost:3305/mapa_acessibilidade?allowPublicKeyRetrieval=true"

# ==========================================
# Chave JWT
# ==========================================
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=1h

# ==========================================
# Frontend e e-mail (recuperação de senha e avisos)
# ==========================================
FRONTEND_URL=http://localhost:5173
# Sem SMTP_HOST, em desenvolvimento os e-mails são apenas impressos no console.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Acessa+ <nao-responder@exemplo.com>"
